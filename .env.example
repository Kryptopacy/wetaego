# App & Domain Configuration
NEXT_PUBLIC_SITE_URL=https://ourmenuos.online
PROD_URL=https://ourmenuos.online
PUBLIC_APP_NAME="OurMenu OS"
SUPPORT_EMAIL=support@ourmenuos.online

# Supabase (PostgreSQL Database & Auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
SUPABASE_ACCESS_TOKEN=

# AI & Multimodal Engine (Google Gemini 3.1 Flash Live, Text & Vision)
GEMINI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Edge Security & Rate Limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Automated Scheduled Tasks & Webhook Retry Engine Secret
CRON_SECRET=

# Payment Gateway 1: Paystack (Local & Card Payments)
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_TEST_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_TEST_PUBLIC_KEY=

# Payment Gateway 2: Bachs Gateway (bachs.io — Fiat, Crypto USDC/USDT/SOL, International Cards & Payouts)
BACHS_API_KEY=
BACHS_WEBHOOK_SECRET=
NEXT_PUBLIC_BACHS_PUBLIC_KEY=
NEXT_PUBLIC_DEFAULT_PAYMENT_GATEWAY=paystack # 'paystack' or 'bachs'

# Transactional Email (Resend)
RESEND_API_KEY=

# Web Push Notifications (PWA VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:hello@ourmenuos.online

# SMS / WhatsApp Notifications (Termii)
TERMII_API_KEY=
TERMII_SENDER_ID=

# Analytics (PostHog)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Google Maps & Geofencing Platform
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Error Monitoring & Telemetry (Sentry)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
