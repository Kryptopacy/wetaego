# App
APP_URL=http://localhost:4173
PUBLIC_APP_NAME="OurMenu OS"

# Supabase
# Browser-safe publishable key only. Never expose service role keys to client code.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Raw PostgreSQL Connection (If used via 'pg' or ORM in the future)
# IMPORTANT: For Next.js Serverless or Edge functions, ALWAYS use the pooled connection port (6543, Supavisor).
# Do not use the direct port (5432) in production to avoid connection exhaustion.
# DATABASE_URL=postgres://[user].[project]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Storage
MENU_MEDIA_BUCKET=menu-media
QR_MEDIA_BUCKET=qr-codes

# Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=

# Email
RESEND_API_KEY=
SUPPORT_EMAIL=
