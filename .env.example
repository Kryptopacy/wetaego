# App
NEXT_PUBLIC_SITE_URL=https://ourmenuos.online
PUBLIC_APP_NAME="OurMenu OS"

# Supabase
# Browser-safe publishable key only. Never expose service role keys to client code.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# Storage
# Buckets used in code: 'menu-images', 'public-assets', 'intercom-media'


PAYSTACK_SECRET_KEY=
PAYSTACK_TEST_SECRET_KEY=

# Bachs Gateway (bachs.io) - Fiat, Crypto, International & Payouts
BACHS_API_KEY=
BACHS_WEBHOOK_SECRET=
NEXT_PUBLIC_BACHS_PUBLIC_KEY=
NEXT_PUBLIC_DEFAULT_PAYMENT_GATEWAY=paystack # or 'bachs'


# Email
RESEND_API_KEY=
SUPPORT_EMAIL=
